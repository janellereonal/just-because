# Postgres (Neon). Use the *pooled* URL here; the unpooled one is used for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Login (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public URL, e.g. https://just-because.vercel.app (http://localhost:8080 locally)
BETTER_AUTH_URL=

# Google sign-in (optional; the Google button hides when these are empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Photo/voice uploads (Vercel Blob). Leave empty locally to save files to .dev-uploads/
BLOB_READ_WRITE_TOKEN=
