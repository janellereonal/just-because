# Template for local development or the THEPC VM. Copy to .env and keep that
# file private and out of Git; use it with the appropriate Compose override.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_DOMAIN=justbecause.site
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://justbecause.site
APP_BASE_URL=https://justbecause.site
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=
MEDIA_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://media.justbecause.site
# Cloudflare Tunnel token; needed only on THEPC, never use a staging token here.
TUNNEL_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
CRON_SECRET=
CONCIERGE_EMAIL=
VITE_POSTHOG_KEY=
VITE_POSTHOG_REGION=us
