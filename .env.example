# Postgres (Neon). Use the *pooled* URL here; the unpooled one is used for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Login (Better Auth). Optional: if empty, a secret is derived from DATABASE_URL.
# To set your own: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public URL, e.g. https://just-because.vercel.app (http://localhost:8080 locally)
BETTER_AUTH_URL=

# Google sign-in (optional; the Google button hides when these are empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Photo/voice uploads (Vercel Blob). Leave empty locally to save files to .dev-uploads/
BLOB_READ_WRITE_TOKEN=

# Emails (Resend): verify email, password reset, new-note alerts, gift-is-live.
# Leave empty locally to print emails to the server log instead.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. Just Because <hello@gifts.yourdomain.com>
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Payments: PayMongo (TEST keys only for now) ---
# Dashboard → Developers → API keys. Use sk_test_ / pk_test_ keys.
# Live keys are refused unless PAYMONGO_ALLOW_LIVE=true is also set.
PAYMONGO_SECRET_KEY=
# Not used by hosted checkout today; kept for a future in-page flow.
PAYMONGO_PUBLIC_KEY=
# Shown once when you create the webhook (whsk_...).
PAYMONGO_WEBHOOK_SECRET=
# Public address of the app, used for checkout return links and emails.
# e.g. https://justbecause.site (local: http://localhost:8080)
APP_BASE_URL=

# --- Daily job (/api/cron/daily) ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Without it the job refuses to run (503).
# It sends end-of-plan reminders, re-checks unpaid orders with PayMongo and expires stale ones.
# Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
